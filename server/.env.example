ENV=local
# Required when ENV is not local: a stable random value of at least 32 characters.
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://bob:bob@localhost:5432/bob
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# BOB's model (Azure OpenAI). Leave empty to run on rules only.
MICROSOFT_AZURE_OPENAI_ENDPOINT=
MICROSOFT_AZURE_OPENAI_KEY=
MICROSOFT_AZURE_OPENAI_DEPLOYMENT_NAME=
BOB_ENABLED=true
